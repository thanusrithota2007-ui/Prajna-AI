# Meterless Runtime OpenAI-compatible provider
METERLESS_RUNTIME_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_RUNTIME_MODEL=meterless/auto

# Scout must use the same signing secret as the Scout sidecar.
SCOUT_SIGNING_SECRET=

# Select either `meterless` (default) or `nvidia` as the evaluation model provider.
AI_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=
